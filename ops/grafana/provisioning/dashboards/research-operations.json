{
  "uid": "mas-research-operations",
  "title": "Research Operations",
  "description": "Worker job throughput/outcomes and worker-side LLM spend for multi-agent-search.",
  "tags": ["multi-agent-search", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(mas_worker_jobs_total, worker_name)",
        "query": { "query": "label_values(mas_worker_jobs_total, worker_name)", "refId": "worker-var" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1
      },
      {
        "name": "job_type",
        "label": "Job type",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(mas_worker_jobs_total, job_type)",
        "query": { "query": "label_values(mas_worker_jobs_total, job_type)", "refId": "job-type-var" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1
      },
      {
        "name": "research_id",
        "label": "Research ID",
        "description": "Research id to show API and worker logs for (Logs row).",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Workers",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Jobs processed by worker",
      "description": "Job attempts per second per worker replica (mas_worker_jobs_total), retries included.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (worker_name) (rate(mas_worker_jobs_total{worker_name=~\"$worker\", job_type=~\"$job_type\"}[5m]))",
          "legendFormat": "{{worker_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Jobs processed by type",
      "description": "Job attempts per second split by job type (search, finalize, maintenance), retries included.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job_type) (rate(mas_worker_jobs_total{worker_name=~\"$worker\", job_type=~\"$job_type\"}[5m]))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failed job attempts",
      "description": "Failed job attempts per second (status=failure). Every failed attempt counts, including one that is then retried, so a job that exhausts JOB_MAX_ATTEMPTS (3) adds three failures; dead-lettered jobs are on Platform Overview.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "spanNulls": true },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job_type) (rate(mas_worker_jobs_total{worker_name=~\"$worker\", job_type=~\"$job_type\", status=\"failure\"}[5m]))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Job success ratio",
      "description": "Share of job attempts with status=success over the last 5 minutes; a retried job counts once per attempt.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(mas_worker_jobs_total{worker_name=~\"$worker\", job_type=~\"$job_type\", status=\"success\"}[5m])) / clamp_min(sum(rate(mas_worker_jobs_total{worker_name=~\"$worker\", job_type=~\"$job_type\"}[5m])), 1e-9)",
          "legendFormat": "success ratio"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total jobs processed",
      "description": "Cumulative job attempts since process start (all workers), retries included.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(mas_worker_jobs_total{worker_name=~\"$worker\", job_type=~\"$job_type\"})",
          "legendFormat": "jobs",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "LLM Cost",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM cost per hour by model (workers only)",
      "description": "Estimated worker-side spend rate (USD/hour) from the worker scrape job's mas_llm_cost_usd_total (search and finalize jobs). LLM calls made inside the API (decompose, optimize, clarify, plan approval, chat, summary) are left out on purpose: the API runs several uvicorn processes without prometheus_client multiprocess mode, each scrape reads one process's counter at random, and rate() turns every switch between processes into a counter reset worth that process's whole lifetime total. Exact spend including API-side calls is in the admin panel's Analytics tab (llm_usage_logs).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model) (rate(mas_llm_cost_usd_total{job=\"multi-agent-search-workers\"}[5m])) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "LLM cost in time range by model, workers only (USD)",
      "description": "Estimated worker-side LLM spend per model over the selected time range, from the worker scrape job only (increase() tolerates worker restarts, unlike the raw counter). API-side calls (decompose, optimize, clarify, plan approval, chat, summary) are not included, because the multi-process API counter would add phantom spend on every scrape that lands on a different uvicorn process. For exact totals including the API, use the admin panel's Analytics tab (llm_usage_logs).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model) (increase(mas_llm_cost_usd_total{job=\"multi-agent-search-workers\"}[$__range]))",
          "legendFormat": "{{model}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Logs for research $research_id",
      "description": "API and worker JSON logs (LOG_FORMAT=json) whose research_id matches the Research ID box above; empty until an id is entered.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 27 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=~\"api|worker.*\"} |= \"$research_id\" | json | __error__=\"\" | research_id=\"$research_id\" | line_format \"{{.level}} {{.logger}} {{.message}}\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
