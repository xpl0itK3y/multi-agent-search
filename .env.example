# Ваш API ключ DeepSeek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
# Per-user requests/minute across optimize, decompose, research start and chat (0 disables).
# LLM_ROUTE_RATE_LIMIT_PER_MINUTE=30
# Reasoning-модель для planner/gap-analysis (должна отдавать reasoning_content); если не задана — берётся DEEPSEEK_MODEL.
# Значения DEEPSEEK_REASONER_MODEL / DEEPSEEK_REPAIR_MODEL уходят в API как есть (их не выбирают
# пользователи); модель с 'reasoner' в имени тарифицируется по ставке pro.
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# DEEPSEEK_REPAIR_MODEL=
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=multi-agent-search-dev
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
TASK_STORE_BACKEND=postgres

# Search backend (P2). With a Tavily key, SEARCH_BACKEND=auto uses Tavily (relevant
# results + page content in one call, no DuckDuckGo rate-limit ceiling) and falls
# back to DuckDuckGo on error. Without a key it stays on DuckDuckGo.
# TAVILY_API_KEY=tvly-your_key_here
# SEARCH_BACKEND=auto            # auto | tavily | duckduckgo
# TAVILY_SEARCH_DEPTH=advanced   # basic | advanced
# TAVILY_INCLUDE_RAW_CONTENT=true
# Shared TTL cache for search results — repeated queries skip the (paid) search API.
# SEARCH_CACHE_ENABLED=true
# SEARCH_CACHE_TTL_SECONDS=86400

# Auth — ON by default (AUTH_DISABLED=false). The API refuses to start until
# AUTH_SECRET_KEY (it signs session tokens) is a random value of at least 32
# characters; the built-in default and shorter values are rejected. Generate one:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
# AUTH_COOKIE_SECURE=true   # when the UI is served over HTTPS
# Trusted local single-user setup only: no login, every request runs as one shared
# local user, and while ADMIN_EMAILS is empty that user passes every admin check.
# AUTH_DISABLED=true
# Admins: comma-separated emails. An account is admin only if its email is listed here
# AND it is linked to Google or was provisioned with `python scripts/create_admin.py <email>`.
# Listed addresses cannot self-register; a password account whose address is added here
# later stays a normal user until you run the script for it (it replaces the password).
# Password-only admins from before the upgrade run it once. While this is set,
# AUTH_SECRET_KEY must be strong even with AUTH_DISABLED=true (see README
# "Authentication and Admins").
# ADMIN_EMAILS=ops@example.com
# Per-admin budget per minute for every admin mutation and CSV export (0 disables).
# ADMIN_RATE_LIMIT_PER_MINUTE=10
# Per-user budget per minute for POST /v1/telemetry/event (0 disables).
# TELEMETRY_RATE_LIMIT_PER_MINUTE=120
# Sign in with Google (OAuth2). Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials, add the web UI's callback as an
# authorized redirect URI (Docker Compose serves the UI on WEB_PORT, default 8502) and
# set GOOGLE_REDIRECT_URI to the same URL:
#   http://localhost:8502/v1/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:8502/v1/auth/google/callback
# ALLOW_MEMORY_TASK_STORE=false
# SMOKE_ANALYZER_REPORT=smoke final report

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=multi_agent_search
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
FINALIZE_WORKER_INTERVAL=2.0
# Heavy queue recovery/cleanup runs less often than the normal job poll.
QUEUE_MAINTENANCE_INTERVAL_SECONDS=60
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/multi_agent_search

# Redis broker (optional) — set USE_REDIS_BROKER=true to replace Postgres polling
# REDIS_URL=redis://localhost:6379/0
# USE_REDIS_BROKER=true
# REDIS_BROKER_POP_TIMEOUT_SECONDS=2

# Observability — /metrics is served by the API and each worker (Prometheus
# scrapes them over the internal Docker network; nginx blocks external access).
# Optional shared secret for the API's /metrics (defense in depth). When set,
# add `authorization: credentials: <token>` to the scrape jobs in
# ops/prometheus/prometheus.yml.
# METRICS_TOKEN=change-me
# Retention for finished researches (seconds). 0 = keep forever (default).
# RESEARCH_RETENTION_SECONDS=0
# Retention for admin telemetry (seconds): user_events rows and telemetry sessions
# (user_sessions) older than this are deleted. Default 7776000 = 90 days.
# USER_EVENTS_RETENTION_SECONDS=7776000
# USER_SESSIONS_RETENTION_SECONDS=7776000
# Retention for the admin audit log (seconds). 0 = keep forever (default).
# ADMIN_AUDIT_RETENTION_SECONDS=0
