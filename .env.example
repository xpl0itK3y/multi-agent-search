# Ваш API ключ DeepSeek
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
# Reasoning-модель для planner/gap-analysis (должна отдавать reasoning_content); если не задана — берётся DEEPSEEK_MODEL
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=multi-agent-search-dev
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
TASK_STORE_BACKEND=postgres

# Auth — off by default (single-tenant). For a public deployment:
#   AUTH_DISABLED=false
#   AUTH_SECRET_KEY=<long-random-string>
#   AUTH_COOKIE_SECURE=true   # when served over HTTPS
# ALLOW_MEMORY_TASK_STORE=false
# SMOKE_ANALYZER_REPORT=smoke final report

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=multi_agent_search
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
FINALIZE_WORKER_INTERVAL=2.0
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/multi_agent_search

# Redis broker (optional) — set USE_REDIS_BROKER=true to replace Postgres polling
# REDIS_URL=redis://localhost:6379/0
# USE_REDIS_BROKER=true
# REDIS_BROKER_POP_TIMEOUT_SECONDS=2
